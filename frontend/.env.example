# Coco English frontend — copy to frontend/.env and adjust.
# Only VITE_* variables are exposed to the client.

# Backend origin the kiosk page talks to.
# Dev default is http://127.0.0.1:8000; set this before `npm run build`
# for production (e.g. https://coco-api.example.com).
VITE_API_BASE=http://127.0.0.1:8000

# G2 safety timers (milliseconds). Defaults match the backend's
# SESSION_MAX_SECONDS=180 and the 60s idle wrap-up.
# VITE_SESSION_MAX_MS=180000
# VITE_SESSION_IDLE_MS=60000
# Max farewell playback after a natural finish before going home (15s).
# VITE_FAREWELL_TIMEOUT_MS=15000
