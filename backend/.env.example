# Coco English backend — copy to backend/.env and adjust.
# uvicorn does not load .env automatically; export these or use a launcher
# (e.g. `set -a; source backend/.env; set +a` / docker --env-file).

# App identity (shows in /api/health)
APP_NAME=coco-english

# In-memory sessions older than this are purged; expired sessions 404
# so the kiosk restarts its flow (spec §8.3: context never outlives the session).
SESSION_TTL_SECONDS=600

# Total lifetime cap for one session in seconds (child safety bound);
# a natural finish deletes the session immediately regardless. <= 0 disables.
SESSION_MAX_SECONDS=180

# Dialogue engine: "mock" (scripted, no network) | "llm" (OpenAI-compatible).
# "llm" without LLM_API_KEY refuses to start.
ENGINE_PROVIDER=mock

# LLM settings (only used when ENGINE_PROVIDER=llm)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=6.0

# Speech recognition:
#   "mock"       scripted, offline demo/dev
#   "openai"     OpenAI-compatible POST /audio/transcriptions
#   "openai-chat" OpenAI-compatible POST /chat/completions with base64
#                input_audio (e.g. Alibaba Bailian compatible-mode +
#                audio-capable chat model such as qwen3-omni-flash)
# Real providers without ASR_API_KEY refuse to start — the mock is
# never a silent fallback.
ASR_PROVIDER=mock

# ASR settings (used when ASR_PROVIDER=openai or openai-chat)
ASR_API_BASE=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=10.0

# G3 privacy bounds: max speech upload size in bytes, and the max number
# of voice/text turns per session per rolling minute.
MAX_UPLOAD_BYTES=5000000
SPEECH_RATE_LIMIT_PER_MINUTE=12

# Origins the kiosk frontend may call from (comma-separated).
# Default "*" fits the LAN MVP; tighten in production.
CORS_ALLOW_ORIGINS=*
